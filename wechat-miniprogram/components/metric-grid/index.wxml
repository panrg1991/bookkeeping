<view class="metric-grid">
  <view class="metric" wx:for="{{items}}" wx:key="label">
    <view class="metric-inner">
      <view class="metric-label">{{item.label}}</view>
      <view class="metric-value {{item.cls}}">{{item.value}}</view>
      <view class="metric-sub" wx:if="{{item.sub}}">{{item.sub}}</view>
    </view>
  </view>
</view>
