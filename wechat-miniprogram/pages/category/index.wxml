<view class="page">
  <view class="toolbar">
    <picker mode="selector" range="{{years}}" value="{{yearIndex}}" bindchange="onYearChange">
      <view class="picker">{{year}} 年</view>
    </picker>
    <picker mode="selector" range="{{monthOptions}}" value="{{monthIndex}}" bindchange="onMonthChange">
      <view class="picker">{{monthOptions[monthIndex]}}</view>
    </picker>
  </view>

  <view class="segmented">
    <view class="segment {{type === 'expense' ? 'active' : ''}}" data-type="expense" bindtap="onTypeChange">支出结构</view>
    <view class="segment {{type === 'income' ? 'active' : ''}}" data-type="income" bindtap="onTypeChange">收入结构</view>
  </view>

  <view class="card">
    <view class="cat-total-row">
      <text class="muted">{{periodLabel}} · {{type === 'expense' ? '支出' : '收入'}}合计</text>
      <text class="cat-total {{type === 'expense' ? 'expense-text' : 'income-text'}}">{{total.amount}}</text>
    </view>
    <view class="muted cat-sub">共 {{total.kinds}} 个分类 · {{total.count}} 笔</view>

    <view class="cat-row" wx:for="{{rows}}" wx:key="category">
      <text class="cat-name">{{item.category}}</text>
      <view class="cat-bar-wrap">
        <view
          class="cat-bar"
          style="width:{{item.percent}}%;background:{{type === 'expense' ? '#16a34a' : '#dc2626'}}"
        ></view>
      </view>
      <text class="cat-amount {{type === 'expense' ? 'expense-text' : 'income-text'}}">{{item.amount}}</text>
      <text class="cat-ratio">{{item.ratioText}}%</text>
    </view>

    <view class="empty" wx:if="{{!hasData}}">{{periodLabel}}暂无{{type === 'expense' ? '支出' : '收入'}}数据</view>
  </view>

  <view class="card">
    <view class="combo-head">
      <text class="card-title">组合计算</text>
      <text class="combo-clear" wx:if="{{comboInput}}" bindtap="onComboClear">清空</text>
    </view>
    <view class="muted combo-tip">输入 2~8 个数（逗号、空格或换行分隔），可同时选择多种组合方式，结果为它们各自的组合乘积之和相加。</view>

    <textarea
      class="combo-input"
      value="{{comboInput}}"
      placeholder="例如：2,3,2"
      placeholder-class="combo-placeholder"
      maxlength="1000"
      auto-height
      bindinput="onComboInput"
    />

    <view class="muted combo-pick-tip">组合方式（可多选）</view>
    <view class="combo-ks">
      <view
        class="combo-k {{item.active ? 'on' : ''}} {{item.enabled ? '' : 'off'}}"
        wx:for="{{comboOptions}}"
        wx:key="k"
        data-k="{{item.k}}"
        bindtap="onComboKToggle"
      >{{item.k}} 个数</view>
    </view>

    <view class="combo-error" wx:if="{{comboError}}">{{comboError}}</view>
    <view class="muted combo-notice" wx:if="{{comboNotice}}">{{comboNotice}}</view>

    <view class="combo-result" wx:if="{{comboSum}}">
      <text class="muted">{{comboLabel}} 个数组合 · 共 {{comboCount}} 组 · 乘积之和</text>
      <text class="combo-sum">{{comboSum}}</text>
    </view>
  </view>
</view>
