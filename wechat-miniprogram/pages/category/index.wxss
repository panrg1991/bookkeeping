.cat-total-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.cat-total {
  font-size: 40rpx;
  font-weight: 700;
}

.cat-sub {
  margin-bottom: 12rpx;
}

/* ------------------------------ 组合计算 ------------------------------ */
.combo-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.combo-head .card-title {
  margin-bottom: 0;
}

.combo-clear {
  font-size: 26rpx;
  color: #2563eb;
}

.combo-tip {
  margin: 10rpx 0 16rpx;
}

.combo-input {
  width: 100%;
  min-height: 92rpx;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border: 2rpx solid #e3e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.combo-placeholder {
  color: #9ca3af;
  font-size: 28rpx;
}

.combo-pick-tip {
  margin: 18rpx 0 8rpx;
}

.combo-ks {
  display: flex;
  flex-wrap: wrap;
}

.combo-k {
  padding: 10rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  border: 2rpx solid #e3e8f0;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #374151;
  background: #ffffff;
}

.combo-k.on {
  background: #2563eb;
  border-color: #2563eb;
  color: #ffffff;
}

.combo-k.off {
  color: #c3cbd8;
  background: #f8fafc;
}

.combo-error {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #dc2626;
}

.combo-notice {
  margin-top: 12rpx;
}

.combo-result {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  padding: 20rpx;
  background: #eff6ff;
  border-radius: 12rpx;
}

.combo-sum {
  margin-top: 6rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #2563eb;
  word-break: break-all;
}


