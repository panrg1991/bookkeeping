<view class="page">
  <view class="card">
    <view class="card-title">操作日志概览</view>
    <view class="muted">共 {{total}} 条（只包含本人的操作记录）</view>
    <view class="stat-line" wx:if="{{stats.length}}">
      <text class="stat-item" wx:for="{{stats}}" wx:key="key">{{item.label}} {{item.value}}</text>
    </view>
    <view class="log-actions">
      <view class="btn ghost" bindtap="onClearLogs">清理 30 天前日志</view>
    </view>
    <view class="muted log-tip">每条新增 / 修改 / 删除 / 导入都会留痕：记录操作时间、变更前后数据、变更字段与失败原因，便于事后排查。</view>
  </view>

  <view class="segmented">
    <view
      class="segment {{filterAction === item.value ? 'active' : ''}}"
      wx:for="{{filters}}"
      wx:key="value"
      data-value="{{item.value}}"
      bindtap="onFilterChange"
    >{{item.label}}</view>
  </view>

  <view class="card" wx:if="{{!logs.length}}">
    <view class="empty">{{loading ? '加载中…' : '暂无操作日志'}}</view>
  </view>

  <view class="log-list" wx:else>
    <view class="log-item" wx:for="{{logs}}" wx:key="id">
      <view class="log-head">
        <text class="tag {{item.cls}}">{{item.label}}</text>
        <text class="log-time">{{item.time}}</text>
      </view>
      <view class="log-summary">{{item.summary}}</view>
      <view class="log-detail" wx:if="{{item.detail}}">{{item.detail}}</view>
      <view class="log-meta muted" wx:if="{{item.client}}">{{item.client}}</view>
    </view>

    <view class="load-more" wx:if="{{hasMore && !loading}}" bindtap="onLoadMore">加载更多</view>
    <view class="load-more muted" wx:elif="{{!loading}}">没有更多了</view>
  </view>
</view>
