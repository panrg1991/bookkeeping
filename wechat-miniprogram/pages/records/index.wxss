.card.editing {
  border: 2rpx solid #2563eb;
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.form-head-actions {
  display: flex;
}

.link {
  font-size: 26rpx;
  color: #2563eb;
  margin-left: 24rpx;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.segmented.inline {
  flex: 1;
  margin-bottom: 0;
  margin-left: 16rpx;
}

.form-actions {
  display: flex;
  padding-top: 24rpx;
}

.search-input {
  background: #ffffff;
  border: 2rpx solid #e3e8f0;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

/* 导入区域 */
.import-box {
  background: #f8fafc;
  border: 2rpx solid #e3e8f0;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.import-hint {
  line-height: 1.6;
  margin-bottom: 14rpx;
}

.import-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  background: #ffffff;
  border: 2rpx solid #e3e8f0;
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 26rpx;
}

.backup-row {
  display: flex;
  padding-bottom: 16rpx;
}

.import-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
}

/* 记录卡片 */
.rec-list {
  padding-bottom: 20rpx;
}

.rec-card {
  display: flex;
  align-items: flex-start;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.06);
  border: 2rpx solid transparent;
}

.rec-card.is-checked {
  border-color: #2563eb;
  background: #f8fbff;
}

.list-head-actions {
  display: flex;
}

.select-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #eff6ff;
  border: 2rpx solid #bfdbfe;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.select-info {
  font-size: 26rpx;
  color: #1d4ed8;
}

.select-actions {
  display: flex;
  align-items: center;
}

.select-actions .btn {
  margin: 0 0 0 20rpx;
}

.rec-check {
  padding-right: 18rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 26rpx;
  color: transparent;
}

.checkbox.on {
  background: #2563eb;
  border-color: #2563eb;
  color: #ffffff;
}

.rec-main {
  flex: 1;
  min-width: 0;
}

.rec-line {
  display: flex;
  align-items: center;
}

.rec-cat {
  font-size: 28rpx;
  margin-left: 16rpx;
}

.rec-amount {
  font-size: 30rpx;
  font-weight: 600;
  margin-left: auto;
}

.computed-amount {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #2563eb;
}

.rec-unit {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.rec-meta {
  display: flex;
  margin-top: 8rpx;
}

.rec-note {
  margin-left: 8rpx;
}

.rec-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.mini-btn {
  font-size: 24rpx;
  color: #2563eb;
  border: 2rpx solid #dbeafe;
  border-radius: 8rpx;
  padding: 6rpx 20rpx;
  margin-left: 16rpx;
}

.mini-btn.danger {
  color: #dc2626;
  border-color: #fecaca;
}
